{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:erts-wasm:planning-evidence:v1",
  "title": "ERTS-Wasm planning evidence profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "record_id",
    "evidence_kind",
    "synthetic",
    "producer",
    "reviewer",
    "plan_baseline",
    "candidate",
    "execution",
    "toolchains",
    "sources",
    "artifacts",
    "contract_ref",
    "observations",
    "observation_artifact_ids",
    "outcome",
    "limitations",
    "support_refs"
  ],
  "properties": {
    "profile": {"const": "erts-wasm.planning-evidence.v1"},
    "record_id": {"$ref": "#/$defs/dottedId"},
    "evidence_kind": {
      "enum": [
        "contract_research",
        "native_c",
        "emscripten_wasm",
        "browser_runtime"
      ]
    },
    "synthetic": {"type": "boolean"},
    "producer": {"$ref": "#/$defs/nonempty"},
    "reviewer": {
      "oneOf": [
        {"$ref": "#/$defs/nonempty"},
        {"type": "null"}
      ]
    },
    "plan_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "revision", "task_ids", "gate_ids"],
      "properties": {
        "document_id": {"$ref": "#/$defs/dottedId"},
        "revision": {"$ref": "#/$defs/nonempty"},
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/taskId"},
          "uniqueItems": true
        },
        "gate_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/gateId"},
          "uniqueItems": true
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty_state", "diff_sha256"],
      "properties": {
        "revision": {"$ref": "#/$defs/nonempty"},
        "dirty_state": {"enum": ["clean", "dirty"]},
        "diff_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "tested_revision", "commands"],
      "properties": {
        "status": {"enum": ["not_run", "completed", "blocked"]},
        "tested_revision": {"$ref": "#/$defs/nonempty"},
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/command"}
        }
      }
    },
    "toolchains": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/toolchain"}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/fileRecord"}
    },
    "artifacts": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/fileRecord"}
    },
    "contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "observations": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/contractResearchObservations"},
        {"$ref": "#/$defs/nativeCObservations"},
        {"$ref": "#/$defs/emscriptenWasmObservations"},
        {"$ref": "#/$defs/browserRuntimeObservations"}
      ]
    },
    "observation_artifact_ids": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/dottedId"},
      "uniqueItems": true
    },
    "outcome": {"enum": ["pass", "fail", "blocked", "not_run"]},
    "limitations": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/nonempty"}
    },
    "support_refs": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/dottedId"},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"enum": ["pass", "fail"]}}},
      "then": {"properties": {"execution": {"properties": {"status": {"const": "completed"}}}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "blocked"}}},
      "then": {"properties": {"execution": {"properties": {"status": {"const": "blocked"}}}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "not_run"}}},
      "then": {"properties": {"execution": {"properties": {"status": {"const": "not_run"}}}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "pass"}}},
      "then": {
        "properties": {
          "synthetic": {"const": false},
          "reviewer": {"$ref": "#/$defs/nonempty"},
          "toolchains": {"minItems": 1},
          "artifacts": {"minItems": 1},
          "observations": {"not": {"type": "null"}},
          "observation_artifact_ids": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"evidence_kind": {"const": "contract_research"}}},
      "then": {"properties": {"observations": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/contractResearchObservations"}]}}}
    },
    {
      "if": {"properties": {"evidence_kind": {"const": "native_c"}}},
      "then": {"properties": {"observations": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/nativeCObservations"}]}}}
    },
    {
      "if": {"properties": {"evidence_kind": {"const": "emscripten_wasm"}}},
      "then": {"properties": {"observations": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/emscriptenWasmObservations"}]}}}
    },
    {
      "if": {"properties": {"evidence_kind": {"const": "browser_runtime"}}},
      "then": {"properties": {"observations": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/browserRuntimeObservations"}]}}}
    }
  ],
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "dottedId": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "gateId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "applicability",
        "path",
        "available",
        "sha256",
        "bytes"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/dottedId"},
        "role": {"$ref": "#/$defs/nonempty"},
        "applicability": {"enum": ["applicable", "not_applicable"]},
        "path": {"$ref": "#/$defs/relativePath"},
        "available": {"type": "boolean"},
        "sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "bytes": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "cwd",
        "exit_code",
        "stdout_sha256",
        "stderr_sha256",
        "result_artifact_ids"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/taskId"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "cwd": {"$ref": "#/$defs/relativePath"},
        "exit_code": {"type": ["integer", "null"]},
        "stdout_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "stderr_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "result_artifact_ids": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/dottedId"},
          "uniqueItems": true
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "executable",
        "version",
        "target",
        "compile_flags",
        "link_flags"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/nonempty"},
        "executable": {"$ref": "#/$defs/nonempty"},
        "version": {"$ref": "#/$defs/nonempty"},
        "target": {"$ref": "#/$defs/nonempty"},
        "compile_flags": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "link_flags": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/nonempty"}
        }
      }
    },
    "contractResearchObservations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "criteria"],
      "properties": {
        "kind": {"const": "contract_research"},
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "outcome", "artifact_ids"],
            "properties": {
              "id": {"$ref": "#/$defs/taskId"},
              "outcome": {"enum": ["pass", "fail", "blocked"]},
              "artifact_ids": {
                "type": "array",
                "items": {"$ref": "#/$defs/dottedId"},
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "nativeCObservations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target_triple", "c_standard", "pointer_bits"],
      "properties": {
        "kind": {"const": "native_c"},
        "target_triple": {"$ref": "#/$defs/nonempty"},
        "c_standard": {"const": "c11"},
        "pointer_bits": {"type": "integer", "enum": [32, 64]}
      }
    },
    "emscriptenWasmObservations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_triple",
        "c_standard",
        "pointer_bits",
        "logical_host_imports",
        "logical_c_exports",
        "memory"
      ],
      "properties": {
        "kind": {"const": "emscripten_wasm"},
        "target_triple": {"$ref": "#/$defs/nonempty"},
        "c_standard": {"const": "c11"},
        "pointer_bits": {"type": "integer", "enum": [32, 64]},
        "logical_host_imports": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonempty"},
          "uniqueItems": true
        },
        "logical_c_exports": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonempty"},
          "uniqueItems": true
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shared", "initial_bytes", "maximum_bytes"],
          "properties": {
            "shared": {"type": "boolean"},
            "initial_bytes": {"type": "integer", "minimum": 1},
            "maximum_bytes": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "browserRuntimeObservations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "browsers",
        "worker_topology",
        "cross_origin_isolated",
        "boot_dispose_cycles",
        "leaked_resources"
      ],
      "properties": {
        "kind": {"const": "browser_runtime"},
        "browsers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "outcome"],
            "properties": {
              "name": {"$ref": "#/$defs/nonempty"},
              "version": {"$ref": "#/$defs/nonempty"},
              "outcome": {"enum": ["pass", "fail", "blocked"]}
            }
          }
        },
        "worker_topology": {"$ref": "#/$defs/nonempty"},
        "cross_origin_isolated": {"type": "boolean"},
        "boot_dispose_cycles": {"type": "integer", "minimum": 1},
        "leaked_resources": {"type": "integer", "minimum": 0}
      }
    }
  }
}
